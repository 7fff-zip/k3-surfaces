check_specialization(c, t, transform) = {
  my(e = fiber(t, c), db = curve(), p = points(), q);
  if(parameter_relation(c[1], c[2]) != 0,
    error("point is off the coefficient curve"));
  if(ellchangecurve(e, transform)[1..5] != db[1..5],
    error("fiber does not transform to the database equation"));
  for(i = 1, #p,
    q = ellchangepointinv(p[i], transform);
    if(!ellisoncurve(db, p[i]) || !ellisoncurve(e, q) || ellchangepoint(q, transform) != p[i],
      error("point transport failed for database point ", i)));
  1
};
check() = {
  if(repository_t(database_t) != t_value || second_repository_t(database_t) != second_t_value,
    error("base coordinate mismatch"));
  check_specialization(coefficient_point, t_value, change);
  check_specialization(second_coefficient_point, second_t_value, second_change)
};
if(check(), print("Verified ICARM #", curve_id, " at T = ", t_value, " and ", second_t_value, ", points checked on each fiber = ", #points()));
