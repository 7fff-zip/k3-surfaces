\\ ICARM Elliptic Curve Rank Leaderboard #273, rank >= 30 (NSF DMS 2425401).
\\ From the repository root, run gp -q curves/273.gp

curve_id = 273;
rank_lower_bound = 30;
surface_label = "1020/QCT";
coefficient_point = [2, -19];  \\ [u, v] on the coefficient curve C.
t_value = 587609/377717;

\\ Here s denotes the T in the database commentary.
database_t = 12473/32946;
repository_t(s) = (22 - 11*s)/(25*s + 2);

\\ A second point of the same coefficient curve gives this database curve.
second_coefficient_point = [153, 1530];
second_t_value = -6421189/587609;
second_repository_t(s) = (425*s + 34)/(11*s - 22);

read_repo(path) = iferr(read(path), err, read(Str("../", path)), errname(err) == "e_FILE");
read_repo("1020/QCT/1020.curve.gp");
read_repo("1020/QCT/1020.surface.gp");

fiber(t = t_value, c = coefficient_point) = ellinit(surface(t, c[1], c[2]));
