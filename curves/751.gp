check() = {
  my(e = fiber(), db = curve(), p = points(), q);
  if(repository_t(database_t) != t_value,
    error("base coordinate mismatch"));
  if(ellchangecurve(e, change)[1..5] != db[1..5],
    error("fiber does not transform to the database equation"));
  for(i = 1, #p,
    q = ellchangepointinv(p[i], change);
    if(!ellisoncurve(db, p[i]) || !ellisoncurve(e, q) || ellchangepoint(q, change) != p[i],
      error("point transport failed for database point ", i)));
  1
};
if(check(), print("Verified ICARM #", curve_id, ", T = ", t_value, ", points checked = ", #points()));
