\\ ICARM #7632, submitted by apkorte. https://elliptic-rank.icarm.cloud/curve/7632
\\ From ns8-icarm run gp -q curves/7632.gp. ICARM / NSF DMS 2425401.

curve_id = 7632;
rank_lower_bound = 18;
marked_point_index = 2;
surface_label = "8/QCT";

\\ Inputs to surface(T,u) in 8.surface.gp. The coefficient curve has one coordinate u.
{coefficient_point = [
  
  / 
];}
{t_value =
  -
  / ;
}

\\ PARI change from the X_8 fiber to the database model.
\\ x_fiber = scale^2*x_db + change[2],  y_fiber = scale^3*y_db.
{scale =
  20311942874619493381279010411774204849403553814218525176078927342844056613238817322460963963774923284888890926956966449841771450862146558557984478856044960
  / 34323839821539797267170355706942596108999708976353184936979243427580174057310617345986588246075556276756308264445176629308621241053928114859859999995243386610606419;
}
change = [scale, scale^2/3, 0, 0];

record_fiber = [coefficient_point[1], t_value, change];

read_repo(path) = iferr(read(path), err, read(Str("../", path)), errname(err) == "e_FILE");
read_repo("8/QCT/8.curve.gp");
read_repo("8/QCT/8.surface.gp");
read_repo("8/QCT/8.sections.gp");

fiber(t = t_value, c = coefficient_point) = ellinit(surface(t, c[1]));
to_database(Q) = ellchangepoint(Q, change);
from_database(P) = ellchangepointinv(P, change);
\\ ellchangecurve(fiber(), change)[1..5] gives the five database coefficients.

curve() = ellinit([0, 1, 0, -172310574977126141641192602258959111706561, 27519183069228245192662707527771242644780655435523774375635135]);
points() = {
