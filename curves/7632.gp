    [6873059167553728443935438715689/5447620864, 17145815613579789528084408428786749282444601387/402078000730112],
    [11682036174312090871045768273681341/58607063025625, 468956545796926946032048855427641123967965814963236/448667836169247828125],
    [41328097277594029053269785902917090/23427603802849, 8187441225432086361963509885290589041488321204011555/113394451919776349743],
