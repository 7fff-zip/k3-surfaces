    [81705998810686193053651770430060548201377/335251262112633316321, 131024109063315679276647753123940884986047343111564085422720/6138406318902827059737457516369],
    [139138121673838968019170724638240503893047/644119363837716819361, 10042383933637462042980919561237778792256390447996388476413120/16347431754563307834477649754609],
    [407548965575448438438966066158521604210119/1765591582854666718449, 15552649208955551002928905709343820521411296020169769204415648/74188292333729614474722920145207],
    [1567943021708632928491769856828664981954309/6066047028564302494276, 236154411371857035392297505144935077171113200250930034694907561/472453052668337717993678587627976],
    [2996744064892158546526384643445241196041351/8284816475666775807361, 2668024150286910391121191641650956356630057738930123827408419296/754092008946514509637229149587391],
    [100267570322063440793633356231585761900881751/349440333004874891152129, 269431485994065985917096307655118292557851050615051378012495189888/206566335816103712019856398731456383],
