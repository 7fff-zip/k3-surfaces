\\ ICARM Elliptic Curve Rank Leaderboard #819, rank >= 30 (NSF DMS 2425401).
\\ From the repository root, run gp -q curves/819.gp

curve_id = 819;
rank_lower_bound = 30;
surface_label = "1092/QCT";
coefficient_point = [-1/8, 37/16];  \\ [u, v] on the coefficient curve C.
t_value = -500246/38623;

\\ Here s denotes the T in the database commentary.
database_t = 21973/509;
repository_t(s) = (90*s + 46)/(85 - 9*s);

read_repo(path) = iferr(read(path), err, read(Str("../", path)), errname(err) == "e_FILE");
read_repo("1092/QCT/1092.curve.gp");
read_repo("1092/QCT/1092.surface.gp");

fiber() = ellinit(surface(t_value, coefficient_point[1], coefficient_point[2]));
curve() = {
  ellinit([
    1,
    0,
    0,
    -6495649539452475553983700741659641381973061496445119220,
    6302745660233214380787297860135380626275509448727774485858616327839978267353056912
  ])
};

\\ PARI change [k, r, s, h] from fiber() to curve().
\\ x_fiber = k^2*x_db + r,  y_fiber = k^3*y_db + s*k^2*x_db + h.
{change = [
  697315320639/24440604737536,
  88379217372981653293262249744817014018071504029141/37333947496029197965459456,
